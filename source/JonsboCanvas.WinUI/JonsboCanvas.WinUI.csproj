<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>JonsboCanvas_WinUI</RootNamespace>
    <AssemblyName>MyCanvas</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <EnableWinAppRunSupport>false</EnableWinAppRunSupport>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseSystemDrawing>true</UseSystemDrawing>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Version>1.3.0</Version>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <FileVersion>1.3.0.0</FileVersion>
    <InformationalVersion>1.3.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- The managed heap stays around 10 MB while frames churn through the large object heap. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="THIRD-PARTY-NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="双击启动正式版.cmd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="管理员启动.cmd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.3.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\JonsboCanvas\AppConfig.cs" Link="Core\AppConfig.cs" />
    <Compile Include="..\JonsboCanvas\AppLanguage.cs" Link="Core\AppLanguage.cs" />
    <Compile Include="..\JonsboCanvas\EmbeddedRuntime.cs" Link="Core\EmbeddedRuntime.cs" />
    <Compile Include="..\JonsboCanvas\UsbDriverManager.cs" Link="Core\UsbDriverManager.cs" />
    <Compile Include="..\JonsboCanvas\NativeDisplay.cs" Link="Core\NativeDisplay.cs" />
    <Compile Include="..\JonsboCanvas\FrameRotation.cs" Link="Core\FrameRotation.cs" />
    <Compile Include="..\JonsboCanvas\Metrics.cs" Link="Core\Metrics.cs" />
    <Compile Include="..\JonsboCanvas\NeteaseLauncher.cs" Link="Core\NeteaseLauncher.cs" />
    <Compile Include="..\JonsboCanvas\NeteaseCdpBridge.cs" Link="Core\NeteaseCdpBridge.cs" />
    <Compile Include="..\JonsboCanvas\NeteaseMedia.cs" Link="Core\NeteaseMedia.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\JonsboCanvas\MSDISPLAYSDKWRRAPER.dll" LogicalName="JonsboCanvas.Embedded.MSDISPLAYSDKWRRAPER.dll" />
    <EmbeddedResource Include="..\JonsboCanvas\libusb0.dll" LogicalName="JonsboCanvas.Embedded.libusb0.dll" />
    <EmbeddedResource Include="..\JonsboCanvas\cpuidsdk.dll" LogicalName="JonsboCanvas.Embedded.cpuidsdk.dll" />
    <EmbeddedResource Include="..\JonsboCanvas\themes\cyber-cyan.png" LogicalName="JonsboCanvas.Embedded.themes.cyber-cyan.png" />
    <EmbeddedResource Include="..\JonsboCanvas\themes\molten-amber.png" LogicalName="JonsboCanvas.Embedded.themes.molten-amber.png" />
    <EmbeddedResource Include="..\JonsboCanvas\themes\aurora-violet.png" LogicalName="JonsboCanvas.Embedded.themes.aurora-violet.png" />
    <EmbeddedResource Include="..\JonsboCanvas\themes\animated-cyan.gif" LogicalName="JonsboCanvas.Embedded.themes.animated-cyan.gif" />
    <EmbeddedResource Include="..\JonsboCanvas\assets\codex-pet-idle.png" LogicalName="JonsboCanvas.Embedded.assets.codex-pet-idle.png" />
    <EmbeddedResource Include="..\JonsboCanvas\assets\claude-companion.png" LogicalName="JonsboCanvas.Embedded.assets.claude-companion.png" />
    <EmbeddedResource Include="..\JonsboCanvas\drivers\MSUSBDisplay\msusbdisplay.inf" LogicalName="JonsboCanvas.Embedded.driver.msusbdisplay.inf" />
    <EmbeddedResource Include="..\JonsboCanvas\drivers\MSUSBDisplay\MSUSBDisplay.cat" LogicalName="JonsboCanvas.Embedded.driver.MSUSBDisplay.cat" />
    <EmbeddedResource Include="..\JonsboCanvas\drivers\MSUSBDisplay\amd64\libusb0.sys" LogicalName="JonsboCanvas.Embedded.driver.libusb0.sys" />
    <EmbeddedResource Include="..\JonsboCanvas\drivers\MSUSBDisplay\x86\libusb0_x86.dll" LogicalName="JonsboCanvas.Embedded.driver.libusb0_x86.dll" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <Target Name="CopyWinUIResourcesToPublishDirectory" AfterTargets="Publish">
    <ItemGroup>
      <_WinUIRuntimeResource Include="$(TargetDir)*.xbf" />
      <_WinUIRuntimeResource Include="$(TargetDir)$(AssemblyName).pri" />
    </ItemGroup>
    <Copy SourceFiles="@(_WinUIRuntimeResource)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>
  </PropertyGroup>
</Project>

