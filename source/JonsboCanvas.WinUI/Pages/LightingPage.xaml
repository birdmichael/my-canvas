<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="JonsboCanvas_WinUI.LightingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:JonsboCanvas_WinUI">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="4">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="{local:Str Key=Lighting.Title}" />
            <TextBlock Margin="0,0,0,16" Style="{StaticResource PageSubtitleStyle}" Text="{local:Str Key=Lighting.Subtitle}" />

            <Border Padding="20" Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        x:Name="CurrentSwatch"
                        Width="72"
                        Height="72"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="36" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{local:Str Key=Lighting.Enable}" />
                        <TextBlock x:Name="CurrentText" Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="EnabledToggle" Grid.Column="2" VerticalAlignment="Center" Toggled="EnabledToggle_Toggled" />
                </Grid>
            </Border>

            <local:SettingsCard Glyph="&#xE706;" Header="{local:Str Key=Lighting.Brightness}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Slider
                        x:Name="BrightnessSlider"
                        Width="240"
                        VerticalAlignment="Center"
                        Maximum="100"
                        Minimum="0"
                        ValueChanged="BrightnessSlider_ValueChanged" />
                    <TextBlock x:Name="BrightnessText" Width="40" VerticalAlignment="Center" TextAlignment="Right" />
                </StackPanel>
            </local:SettingsCard>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{local:Str Key=Lighting.HardwareSection}" />
            <local:SettingsCard Description="{local:Str Key=Lighting.Hardware.Hint}" Glyph="&#xE91B;" Header="{local:Str Key=Lighting.Source}">
                <local:Segmented x:Name="HardwareSource" />
            </local:SettingsCard>
            <Border x:Name="HardwareColors" Style="{StaticResource CardStyle}">
                <StackPanel x:Name="HardwareSwatches" Orientation="Horizontal" Spacing="10" />
            </Border>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{local:Str Key=Lighting.MusicSection}" />
            <local:SettingsCard Description="{local:Str Key=Lighting.Music.Hint}" Glyph="&#xE93C;" Header="{local:Str Key=Lighting.Source}">
                <local:Segmented x:Name="MusicSource" />
            </local:SettingsCard>
            <Border x:Name="MusicColors" Style="{StaticResource CardStyle}">
                <StackPanel x:Name="MusicSwatches" Orientation="Horizontal" Spacing="10" />
            </Border>
            <local:SettingsCard Description="{local:Str Key=Lighting.Beat.Hint}" Glyph="&#xE995;" Header="{local:Str Key=Lighting.Beat}">
                <ToggleSwitch x:Name="BeatToggle" Toggled="BeatToggle_Toggled" />
            </local:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
