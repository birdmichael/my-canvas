<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="JonsboCanvas_WinUI.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:JonsboCanvas_WinUI">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="4">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="{local:Str Key=Settings.Title}" />

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{local:Str Key=Settings.GeneralSection}" />
            <local:SettingsCard Glyph="&#xF2B7;" Header="{local:Str Key=Settings.Language}">
                <ComboBox x:Name="LanguagePicker" MinWidth="160" SelectionChanged="LanguagePicker_SelectionChanged">
                    <ComboBoxItem Content="简体中文" Tag="zh-CN" />
                    <ComboBoxItem Content="English" Tag="en-US" />
                </ComboBox>
            </local:SettingsCard>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{local:Str Key=Settings.StartupSection}" />
            <local:SettingsCard Description="{local:Str Key=Settings.StartWithWindows.Hint}" Glyph="&#xE7E8;" Header="{local:Str Key=Settings.StartWithWindows}">
                <ToggleSwitch x:Name="StartupToggle" Toggled="StartupToggle_Toggled" />
            </local:SettingsCard>
            <local:SettingsCard Description="{local:Str Key=Settings.StartHidden.Hint}" Glyph="&#xE73F;" Header="{local:Str Key=Settings.StartHidden}">
                <ToggleSwitch x:Name="HiddenToggle" Toggled="HiddenToggle_Toggled" />
            </local:SettingsCard>
            <local:SettingsCard Description="{local:Str Key=Settings.Tray.Hint}" Glyph="&#xE8A7;" Header="{local:Str Key=Settings.Tray}">
                <ToggleSwitch x:Name="TrayToggle" Toggled="TrayToggle_Toggled" />
            </local:SettingsCard>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{local:Str Key=Settings.AboutSection}" />
            <local:SettingsCard x:Name="AboutCard" Glyph="&#xE946;" Header="My Canvas">
                <Button Click="DataButton_Click" Content="{local:Str Key=Settings.DataFolder}" />
            </local:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
