<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="JonsboCanvas_WinUI.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:JonsboCanvas_WinUI">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="4">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="{local:Str Key=Devices.Title}" />
            <TextBlock Margin="0,0,0,16" Style="{StaticResource PageSubtitleStyle}" Text="{local:Str Key=Devices.Subtitle}" />

            <InfoBar x:Name="ProblemBar" Margin="0,0,0,8" IsClosable="False" IsOpen="False" Severity="Warning" />

            <Border Padding="20" Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon FontSize="28" Glyph="&#xE7F4;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="ConnectionTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{local:Str Key=Devices.Connection.Hint}" />
                    </StackPanel>
                    <Button x:Name="ConnectButton" Grid.Column="2" MinWidth="120" VerticalAlignment="Center" Click="ConnectButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="ConnectProgress" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                            <TextBlock x:Name="ConnectLabel" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <local:SettingsCard x:Name="LongCard" Glyph="&#xE7F4;" Header="{local:Str Key=Devices.Long}">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="LongDot" Width="8" Height="8" VerticalAlignment="Center" />
                        <TextBlock x:Name="LongState" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                    <ComboBox x:Name="LongRotation" MinWidth="120" SelectionChanged="LongRotation_SelectionChanged" />
                </StackPanel>
            </local:SettingsCard>
            <local:SettingsCard x:Name="SquareCard" Glyph="&#xE7F4;" Header="{local:Str Key=Devices.Square}">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="SquareDot" Width="8" Height="8" VerticalAlignment="Center" />
                        <TextBlock x:Name="SquareState" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                    <ComboBox x:Name="SquareRotation" MinWidth="120" SelectionChanged="SquareRotation_SelectionChanged" />
                </StackPanel>
            </local:SettingsCard>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{local:Str Key=Devices.BehaviorSection}" />
            <local:SettingsCard Description="{local:Str Key=Devices.AutoConnect.Hint}" Glyph="&#xE703;" Header="{local:Str Key=Devices.AutoConnect}">
                <ToggleSwitch x:Name="AutoConnectToggle" Toggled="AutoConnectToggle_Toggled" />
            </local:SettingsCard>
            <local:SettingsCard Description="{local:Str Key=Devices.Takeover.Hint}" Glyph="&#xE8AB;" Header="{local:Str Key=Devices.Takeover}">
                <ToggleSwitch x:Name="TakeoverToggle" Toggled="TakeoverToggle_Toggled" />
            </local:SettingsCard>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{local:Str Key=Devices.ToolsSection}" />
            <local:SettingsCard x:Name="DriverCard" Glyph="&#xE964;" Header="{local:Str Key=Devices.Driver}">
                <Button x:Name="RepairButton" Click="RepairButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="RepairProgress" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                        <TextBlock Text="{local:Str Key=Devices.Repair}" />
                    </StackPanel>
                </Button>
            </local:SettingsCard>
            <local:SettingsCard Description="{local:Str Key=Devices.SaveFrame.Hint}" Glyph="&#xE722;" Header="{local:Str Key=Devices.SaveFrame}">
                <Button Click="SaveFrameButton_Click" Content="{local:Str Key=Devices.Save}" />
            </local:SettingsCard>
            <local:SettingsCard Description="{local:Str Key=Devices.Logs.Hint}" Glyph="&#xE9F9;" Header="{local:Str Key=Devices.Logs}">
                <Button Click="LogsButton_Click" Content="{local:Str Key=Common.OpenFolder}" />
            </local:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
